{
  "name": "engram-notion-mcp-monorepo",
  "private": true,
  "workspaces": [
    "mcp-server",
    "mcp-ui"
  ],
  "scripts": {
    "ui:dev": "bun run --cwd mcp-ui dev",
    "ui:build": "bun run --cwd mcp-ui build",
    "server:start": "bun run --filter engram-notion-mcp start",
    "server:build": "bun run --filter engram-notion-mcp build",
    "start": "bun run --parallel --filter '*' start",
    "build": "bun run ui:build && bun run --filter engram-notion-mcp build",
    "dev": "bun run --parallel --filter '*' dev",
    "predelete-dependencies": "rm -f ./bun.lock ./package-lock.json",
    "delete-dependencies": "rm -rf ./node_modules",
    "prerefresh-dependencies": "bun run delete-dependencies",
    "refresh-dependencies": "bun run --parallel --filter '*' install"
  }
}
