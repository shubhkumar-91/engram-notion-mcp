{
  "name": "engram-notion-mcp-monorepo",
  "private": true,
  "workspaces": [
    "mcp-server",
    "mcp-ui"
  ],
  "scripts": {
    "ui:dev": "bun --cwd mcp-ui dev",
    "ui:build": "bun --cwd mcp-ui build",
    "server:start": "bun --filter mcp-server start",
    "server:build": "bun --filter mcp-server build",
    "start": "bun --parallel --filter '*' run start",
    "build": "bun --filter mcp-server build",
    "dev": "bun --parallel --filter '*' run dev",
    "predelete-dependencies": "rm -f ./bun.lock ./package-lock.json",
    "delete-dependencies": "rm -rf ./node_modules",
    "prerefresh-dependencies": "bun run delete-dependencies",
    "refresh-dependencies": "bun --parallel --filter '*' install"
  }
}
